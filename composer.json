{
    "name": "mitinsany/routeros-client",
    "description": "MikroTik RouterOS API client",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=5.4 <7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^4.8.36 || ^9.6",
        "phpcompatibility/php-compatibility": "^9.3",
        "squizlabs/php_codesniffer": "^3.5",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "MitinSany\\RouterOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MitinSany\\RouterOS\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "5.4.45"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "compatibility": "phpcs --runtime-set installed_paths vendor/phpcompatibility/php-compatibility --standard=phpcompatibility.xml.dist"
    }
}
